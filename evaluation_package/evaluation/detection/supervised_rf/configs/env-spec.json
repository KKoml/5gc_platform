{
  "base": "existing read-only Python 3.10 venv with CUDA 12.8 PyTorch",
  "runtime_python": "<REVIEWER_CONFIGURE_PATH>",
  "system_pkgs": [],
  "pip_phases": [],
  "warm_reuse_only": true,
  "must_not_modify_runtime_env": true,
  "env": {
    "PYTHONDONTWRITEBYTECODE": "1",
    "XDG_CACHE_HOME": "<REVIEWER_CONFIGURE_PATH>",
    "TORCH_HOME": "<REVIEWER_CONFIGURE_PATH>",
    "MPLCONFIGDIR": "<REVIEWER_CONFIGURE_PATH>",
    "CUDA_VISIBLE_DEVICES": "",
    "OMP_NUM_THREADS": "8",
    "MKL_NUM_THREADS": "8",
    "OPENBLAS_NUM_THREADS": "8",
    "NUMEXPR_NUM_THREADS": "8"
  },
  "required_versions_observed": {
    "python": "3.10.12",
    "torch": "2.11.0+cu128",
    "numpy": "2.2.6",
    "pandas": "2.3.2",
    "pyarrow": "21.0.0",
    "scikit_learn": "1.7.1",
    "scipy": "1.15.3"
  },
  "resource_shape": {
    "cpus_for_job": 8,
    "gpus": 0
  },
  "smoke": {
    "command": "./run.sh code/environment_probe.py",
    "expect": "CPU_EXPERIMENT_WITNESS_OK"
  },
  "execution_scope": "CPU pilots; unchanged existing environment, no installs"
}
